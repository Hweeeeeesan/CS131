cd ~/cs131/A2
script a2.txt
wc -l combined_replies.txt
awk -F "\t" '{print $2"\t"$7}' combined_replies.txt > replies.txt
wc -l replies.txt
awk -F "\t" '$1 != $2 {print $0}' replies.txt > replies_nobots.txt
wc -l replies_nobots.txt
sort replies_nobots.txt | uniq > replies_nobots_uniq.txt
wc -l replies_nobots_uniq.txt
cut -f2 replies_nobots_uniq.txt | sort | uniq -c | awk '$1 >= 3 {print $2}' > high_influence_replies.txt
cut -f2 replies_nobots_uniq.txt | sort | uniq -c | awk '$1 < 3 {print $2}' > low_influence_replies.txt
wc -l high_influence_replies.txt low_influence_replies.txt
awk -F "\t" 'NR==FNR{high[$1]=1; next} ($2 in high)' high_influence_replies.txt replies_nobots_uniq.txt > replies_nobots_uniq_highinfluence.txt
awk -F "\t" 'NR==FNR{low[$1]=1; next} ($2 in low)' low_influence_replies.txt replies_nobots_uniq.txt > replies_nobots_uniq_lowinfluence.txt
wc -l replies_nobots_uniq_highinfluence.txt replies_nobots_uniq_lowinfluence.txt replies_nobots_uniq.txt
cut -f2 replies_nobots_uniq_highinfluence.txt | sort -u | wc -l
cut -f1 replies_nobots_uniq_highinfluence.txt | sort -u | wc -l
cut -f2 replies_nobots_uniq_highinfluence.txt | sort | uniq -c | sort -rn | head -10
cut -f2 replies_nobots_uniq_lowinfluence.txt | sort -u | wc -l
cut -f1 replies_nobots_uniq_lowinfluence.txt | sort -u | wc -l
cut -f2 replies_nobots_uniq_lowinfluence.txt | sort | uniq -c | sort -rn | head -10
